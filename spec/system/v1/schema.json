{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://smartplantos.local/spec/system/v1/schema.json",
  "$defs": {
    "Backup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "format_version",
        "plants"
      ],
      "properties": {
        "format": {
          "const": "smartplantos.settings"
        },
        "format_version": {
          "const": 1
        },
        "plants": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "plant_id",
              "name",
              "room",
              "species_id"
            ],
            "properties": {
              "plant_id": {
                "type": "string",
                "format": "uuid"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "room": {
                "type": "string",
                "maxLength": 80
              },
              "species_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z0-9-]{1,40}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "BackupPreviewRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backup"
      ],
      "properties": {
        "backup": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "format",
            "format_version",
            "plants"
          ],
          "properties": {
            "format": {
              "const": "smartplantos.settings"
            },
            "format_version": {
              "const": 1
            },
            "plants": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "plant_id",
                  "name",
                  "room",
                  "species_id"
                ],
                "properties": {
                  "plant_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "room": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "species_id": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[a-z0-9-]{1,40}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "BackupRestoreRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backup",
        "snapshot",
        "confirm"
      ],
      "properties": {
        "backup": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "format",
            "format_version",
            "plants"
          ],
          "properties": {
            "format": {
              "const": "smartplantos.settings"
            },
            "format_version": {
              "const": 1
            },
            "plants": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "plant_id",
                  "name",
                  "room",
                  "species_id"
                ],
                "properties": {
                  "plant_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "room": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "species_id": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[a-z0-9-]{1,40}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "snapshot": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "confirm": {
          "const": true
        }
      }
    },
    "BackupPreview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "snapshot",
        "summary",
        "changes"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "snapshot": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "created",
            "updated",
            "unchanged"
          ],
          "properties": {
            "created": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "updated": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "unchanged": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            }
          }
        },
        "changes": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "plant_id",
              "name",
              "room",
              "action",
              "has_controller",
              "previous_name",
              "previous_room"
            ],
            "properties": {
              "plant_id": {
                "type": "string",
                "format": "uuid"
              },
              "name": {
                "type": "string"
              },
              "room": {
                "type": "string"
              },
              "action": {
                "enum": [
                  "create",
                  "update",
                  "unchanged"
                ]
              },
              "has_controller": {
                "type": "boolean"
              },
              "previous_name": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "previous_room": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "Scan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "phase",
        "available",
        "networks"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "phase": {
          "enum": [
            "idle",
            "scanning",
            "completed",
            "failed"
          ]
        },
        "available": {
          "type": "boolean"
        },
        "networks": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ssid",
              "rssi_dbm",
              "channel",
              "supported"
            ],
            "properties": {
              "ssid": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              },
              "rssi_dbm": {
                "type": "integer",
                "minimum": -127,
                "maximum": 0
              },
              "channel": {
                "type": "integer",
                "minimum": 1,
                "maximum": 14
              },
              "supported": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "Diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "format",
        "generated_uptime_ms",
        "hub",
        "network",
        "radio",
        "update",
        "devices"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "format": {
          "const": "smartplantos.diagnostics"
        },
        "generated_uptime_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "hub": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "device_id",
            "firmware_version",
            "uptime_ms",
            "reset_reason",
            "free_heap_bytes",
            "minimum_free_heap_bytes"
          ],
          "properties": {
            "device_id": {
              "type": "string",
              "pattern": "^spo-[a-f0-9]{12}$"
            },
            "firmware_version": {
              "type": "string"
            },
            "uptime_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "reset_reason": {
              "enum": [
                "unknown",
                "power_on",
                "software",
                "panic",
                "interrupt_watchdog",
                "task_watchdog",
                "watchdog",
                "deep_sleep",
                "brownout",
                "usb",
                "other"
              ]
            },
            "free_heap_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "minimum_free_heap_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            }
          }
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "wifi_connected",
            "wifi_phase",
            "channel",
            "rssi_dbm",
            "last_disconnect_reason",
            "setup_ap_enabled"
          ],
          "properties": {
            "wifi_connected": {
              "type": "boolean"
            },
            "wifi_phase": {
              "enum": [
                "idle",
                "connecting",
                "connected",
                "failed",
                "storage_error"
              ]
            },
            "channel": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "rssi_dbm": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -127,
                  "maximum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "last_disconnect_reason": {
              "type": "string"
            },
            "setup_ap_enabled": {
              "type": "boolean"
            }
          }
        },
        "radio": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "channel",
            "received_packets",
            "unknown_packets",
            "header_rejections",
            "authentication_rejections",
            "accepted_messages",
            "tx_attempts",
            "tx_completed",
            "tx_callback_timeouts"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "channel": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "received_packets": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "unknown_packets": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "header_rejections": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "authentication_rejections": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "accepted_messages": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "tx_attempts": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "tx_completed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "tx_callback_timeouts": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            }
          }
        },
        "update": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "phase",
            "error",
            "active",
            "verifying",
            "validated",
            "received_bytes",
            "total_bytes",
            "firmware_version",
            "data_abi",
            "profile",
            "layout",
            "session_id",
            "last_result"
          ],
          "properties": {
            "phase": {
              "enum": [
                "idle",
                "uploading",
                "transferring",
                "rebooting",
                "rebooting_node",
                "completed",
                "failed"
              ]
            },
            "error": {
              "type": "string"
            },
            "active": {
              "type": "boolean"
            },
            "verifying": {
              "type": "boolean"
            },
            "validated": {
              "type": "boolean"
            },
            "received_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "total_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "firmware_version": {
              "type": "string"
            },
            "data_abi": {
              "const": 1
            },
            "profile": {
              "enum": [
                "c3",
                "n8r2",
                "n16r8"
              ]
            },
            "layout": {
              "enum": [
                "ota-v1",
                "factory"
              ]
            },
            "session_id": {
              "type": "string",
              "format": "uuid"
            },
            "last_result": {
              "enum": [
                "none",
                "verifying",
                "validated",
                "rolled_back"
              ]
            },
            "image_sha256": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[a-f0-9]{64}$"
            },
            "target_device_id": {
              "anyOf": [
                {
                  "const": "hub"
                },
                {
                  "type": "string",
                  "pattern": "^spo-[a-f0-9]{12}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "devices": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "device_id",
              "online",
              "last_telemetry_age_ms",
              "firmware_version",
              "rssi_dbm",
              "rssi_age_ms",
              "health"
            ],
            "properties": {
              "device_id": {
                "type": "string",
                "pattern": "^spo-[a-f0-9]{12}$"
              },
              "online": {
                "type": "boolean"
              },
              "last_telemetry_age_ms": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "firmware_version": {
                "type": "string"
              },
              "rssi_dbm": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": -127,
                    "maximum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "rssi_age_ms": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "health": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "age_ms",
                      "uptime_ms",
                      "reset_reason",
                      "free_heap_bytes",
                      "minimum_free_heap_bytes",
                      "radio_enabled",
                      "accepted_messages",
                      "authentication_rejections",
                      "tx_callback_timeouts"
                    ],
                    "properties": {
                      "age_ms": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "uptime_ms": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "reset_reason": {
                        "enum": [
                          "unknown",
                          "power_on",
                          "software",
                          "panic",
                          "interrupt_watchdog",
                          "task_watchdog",
                          "watchdog",
                          "deep_sleep",
                          "brownout",
                          "usb",
                          "other"
                        ]
                      },
                      "free_heap_bytes": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 4294967295
                      },
                      "minimum_free_heap_bytes": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 4294967295
                      },
                      "radio_enabled": {
                        "type": "boolean"
                      },
                      "accepted_messages": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 4294967295
                      },
                      "authentication_rejections": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 4294967295
                      },
                      "tx_callback_timeouts": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 4294967295
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      }
    }
  }
}
